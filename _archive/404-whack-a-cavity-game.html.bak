    <!-- ===================== WHACK-A-CAVITY MINI-GAME (404 page only) =====================
         Self-contained: scoped .wac- styles + inline script, emoji-based (no image downloads).
         Progressive levels, 3 lives, keyboard + touch playable, respects reduced-motion. -->
    <section class="section section--compact wac" aria-labelledby="wacHeading">
      <div class="container">
        <div class="wac__intro text-center">
          <p class="wac__eyebrow">While you&rsquo;re here&hellip;</p>
          <h2 id="wacHeading" class="wac__title">Whack-a-Cavity!</h2>
          <p class="wac__sub">Cavities are popping up! Tap or click each one to fill it before it spreads. It gets faster every level. 🦷✨</p>
        </div>

        <div class="wac__game" id="wacGame">
          <div class="wac__hud" role="status" aria-live="polite">
            <div class="wac__stat"><span class="wac__stat-label">Score</span><span class="wac__stat-val" id="wacScore">0</span></div>
            <div class="wac__stat"><span class="wac__stat-label">Level</span><span class="wac__stat-val" id="wacLevel">1</span></div>
            <div class="wac__stat"><span class="wac__stat-label">Lives</span><span class="wac__stat-val" id="wacLives">❤️❤️❤️</span></div>
          </div>

          <div class="wac__board" id="wacBoard" aria-label="Game board of teeth">
            <!-- tooth cells injected by JS -->
          </div>

          <div class="wac__overlay" id="wacOverlay">
            <div class="wac__panel">
              <p class="wac__panel-emoji" id="wacPanelEmoji">🦷</p>
              <h3 class="wac__panel-title" id="wacPanelTitle">Ready to fight some cavities?</h3>
              <p class="wac__panel-text" id="wacPanelText">Fill the cavities as they pop up. Miss three and it&rsquo;s game over!</p>
              <button class="btn btn-primary wac__btn" id="wacStart" type="button">Start Game</button>
            </div>
          </div>
        </div>

        <p class="wac__hint text-center">Tip: on a computer you can also press the number keys <strong>1&ndash;9</strong> to whack.</p>
      </div>
    </section>

    <style>
      /* ---- Whack-a-Cavity (scoped to .wac, 404 page only) ---- */
      .wac__intro { max-width: 640px; margin: 0 auto var(--space-md); }
      .wac__eyebrow {
        font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase;
        color: var(--color-gold-text); font-weight: 700; margin: 0 0 0.25rem;
      }
      .wac__title { margin: 0 0 0.5rem; }
      .wac__sub { color: var(--color-ink, #333); margin: 0; }

      .wac__game {
        position: relative;
        max-width: 480px;
        margin: 0 auto;
        background: linear-gradient(160deg, #7ec8e3 0%, #63b8dc 55%, #4aa3d0 100%);
        border-radius: 22px;
        padding: 1rem;
        box-shadow: 0 14px 40px rgba(20, 60, 90, 0.28);
      }

      .wac__hud {
        display: flex; justify-content: space-around; gap: 0.5rem;
        margin-bottom: 0.9rem;
      }
      .wac__stat {
        flex: 1; text-align: center;
        background: rgba(255,255,255,0.9);
        border-radius: 14px; padding: 0.45rem 0.3rem;
        box-shadow: 0 3px 0 rgba(0,0,0,0.06);
      }
      .wac__stat-label {
        display: block; font-size: 0.62rem; letter-spacing: 0.1em;
        text-transform: uppercase; color: #6a7b86; font-weight: 700;
      }
      .wac__stat-val {
        display: block; font-size: 1.15rem; font-weight: 700; color: #123; line-height: 1.3;
      }

      .wac__board {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
      }
      .wac__cell {
        position: relative;
        aspect-ratio: 1 / 1;
        border: none;
        border-radius: 16px;
        background: radial-gradient(circle at 50% 38%, #ffffff 0%, #eef4f7 70%, #d9e6ec 100%);
        box-shadow: inset 0 -6px 0 rgba(0,0,0,0.08), 0 4px 10px rgba(0,0,0,0.12);
        font-size: clamp(1.8rem, 9vw, 2.6rem);
        line-height: 1;
        cursor: pointer;
        display: flex; align-items: center; justify-content: center;
        transition: transform 0.08s ease, box-shadow 0.12s ease;
        -webkit-tap-highlight-color: transparent;
        user-select: none;
      }
      .wac__cell:focus-visible {
        outline: 3px solid var(--color-gold-warm, #B8892A);
        outline-offset: 2px;
      }
      .wac__cell:active { transform: scale(0.94); }
      .wac__cell .wac__face { transition: transform 0.15s ease; }

      /* active cavity state */
      .wac__cell.is-cavity {
        background: radial-gradient(circle at 50% 40%, #ffe08a 0%, #f4c04e 65%, #e0a52f 100%);
        box-shadow: inset 0 -6px 0 rgba(0,0,0,0.14), 0 0 0 3px #c98b1f, 0 6px 14px rgba(0,0,0,0.2);
        animation: wacPop 0.18s ease;
      }
      .wac__cell.is-hit {
        background: radial-gradient(circle at 50% 40%, #b8f5c8 0%, #6fe08f 70%, #34c46a 100%);
      }
      @keyframes wacPop {
        from { transform: scale(0.6); }
        to   { transform: scale(1); }
      }

      .wac__overlay {
        position: absolute; inset: 0;
        background: rgba(15, 45, 70, 0.72);
        backdrop-filter: blur(2px);
        border-radius: 22px;
        display: flex; align-items: center; justify-content: center;
        text-align: center; padding: 1.2rem;
        transition: opacity 0.25s ease;
      }
      .wac__overlay.is-hidden { opacity: 0; pointer-events: none; }
      .wac__panel {
        background: #fff; border-radius: 18px; padding: 1.4rem 1.2rem;
        max-width: 320px; box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      }
      .wac__panel-emoji { font-size: 2.6rem; margin: 0 0 0.3rem; }
      .wac__panel-title { margin: 0 0 0.4rem; font-size: 1.3rem; }
      .wac__panel-text { margin: 0 0 1rem; color: #4a5560; font-size: 0.95rem; }
      .wac__btn { margin: 0; }

      .wac__hint { margin: var(--space-sm) auto 0; font-size: 0.85rem; color: #6a7b86; max-width: 480px; }

      @media (max-width: 400px) {
        .wac__game { padding: 0.75rem; }
        .wac__board { gap: 0.45rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        .wac__cell, .wac__cell .wac__face, .wac__overlay { transition: none; }
        .wac__cell.is-cavity { animation: none; }
      }
    </style>

    <script>
      (function () {
        var board   = document.getElementById('wacBoard');
        var scoreEl = document.getElementById('wacScore');
        var levelEl = document.getElementById('wacLevel');
        var livesEl = document.getElementById('wacLives');
        var overlay = document.getElementById('wacOverlay');
        var startBtn = document.getElementById('wacStart');
        var pEmoji  = document.getElementById('wacPanelEmoji');
        var pTitle  = document.getElementById('wacPanelTitle');
        var pText   = document.getElementById('wacPanelText');
        if (!board) return;

        var CELLS = 9;
        var HITS_PER_LEVEL = 6;     // fills needed to advance a level
        var MAX_LEVEL = 8;
        var START_LIVES = 3;

        var cells = [];
        var state = null;           // holds active game state, null when idle

        // Build the 9 tooth cells once
        for (var i = 0; i < CELLS; i++) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'wac__cell';
          btn.setAttribute('data-index', i);
          btn.setAttribute('aria-label', 'Tooth ' + (i + 1));
          btn.innerHTML = '<span class="wac__face" aria-hidden="true">🦷</span>';
          btn.addEventListener('click', onCellClick);
          board.appendChild(btn);
          cells.push(btn);
        }

        function levelSettings(level) {
          // As level rises: cavities appear more often and stay for less time.
          return {
            interval: Math.max(1300 - (level - 1) * 130, 520),   // ms between spawns
            visible:  Math.max(1500 - (level - 1) * 150, 650),   // ms a cavity stays up
            maxActive: Math.min(1 + Math.floor((level - 1) / 2), 3) // up to 3 at once
          };
        }

        function setFace(cell, emoji) {
          cell.querySelector('.wac__face').textContent = emoji;
        }

        function clearCell(cell) {
          cell.classList.remove('is-cavity', 'is-hit');
          setFace(cell, '🦷');
          if (cell._timer) { clearTimeout(cell._timer); cell._timer = null; }
        }

        function spawn() {
          if (!state) return;
          var cfg = levelSettings(state.level);
          var active = cells.filter(function (c) { return c.classList.contains('is-cavity'); });
          if (active.length < cfg.maxActive) {
            var free = cells.filter(function (c) {
              return !c.classList.contains('is-cavity') && !c.classList.contains('is-hit');
            });
            if (free.length) {
              var cell = free[Math.floor(Math.random() * free.length)];
              cell.classList.add('is-cavity');
              setFace(cell, '🦠');
              cell._timer = setTimeout(function () {
                // cavity spread — missed it, lose a life
                if (!cell.classList.contains('is-cavity')) return;
                clearCell(cell);
                loseLife();
              }, cfg.visible);
            }
          }
          state.spawnTimer = setTimeout(spawn, cfg.interval);
        }

        function onCellClick(e) {
          var cell = e.currentTarget;
          if (!state || !cell.classList.contains('is-cavity')) return;
          if (cell._timer) { clearTimeout(cell._timer); cell._timer = null; }
          cell.classList.remove('is-cavity');
          cell.classList.add('is-hit');
          setFace(cell, '✨');
          state.score += 10;
          scoreEl.textContent = state.score;
          setTimeout(function () { clearCell(cell); }, 220);

          state.levelHits++;
          if (state.levelHits >= HITS_PER_LEVEL) {
            if (state.level >= MAX_LEVEL) { win(); return; }
            state.level++;
            state.levelHits = 0;
            levelEl.textContent = state.level;
          }
        }

        function renderLives() {
          livesEl.textContent = state.lives > 0
            ? '❤️'.repeat(state.lives) : '💔';
        }

        function loseLife() {
          if (!state) return;
          state.lives--;
          renderLives();
          if (state.lives <= 0) gameOver();
        }

        function stopTimers() {
          if (state && state.spawnTimer) clearTimeout(state.spawnTimer);
          cells.forEach(clearCell);
        }

        function startGame() {
          stopTimers();
          state = { score: 0, level: 1, levelHits: 0, lives: START_LIVES, spawnTimer: null };
          scoreEl.textContent = '0';
          levelEl.textContent = '1';
          renderLives();
          overlay.classList.add('is-hidden');
          spawn();
        }

        function endScreen(emoji, title, text, btnLabel) {
          stopTimers();
          state = null;
          pEmoji.textContent = emoji;
          pTitle.textContent = title;
          pText.textContent = text;
          startBtn.textContent = btnLabel;
          overlay.classList.remove('is-hidden');
        }

        function gameOver() {
          endScreen('🪥', 'Game Over!',
            'You filled ' + scoreEl.textContent + ' points of cavities. Grab your toothbrush and try again!',
            'Play Again');
        }

        function win() {
          endScreen('🏆', 'Cavity-Fighting Champion!',
            'You cleared all ' + MAX_LEVEL + ' levels with ' + (state ? state.score : scoreEl.textContent) + ' points. Your dentist would be proud!',
            'Play Again');
        }

        startBtn.addEventListener('click', startGame);

        // Number keys 1–9 whack the matching tooth
        document.addEventListener('keydown', function (e) {
          if (!state) return;
          var n = parseInt(e.key, 10);
          if (n >= 1 && n <= 9 && cells[n - 1]) {
            cells[n - 1].click();
          }
        });
      })();
    </script>

  </main>

